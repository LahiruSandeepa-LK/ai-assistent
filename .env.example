# ---- LLM ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
# ---- Embeddings ----
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
# ---- Vector DB ----
PINECONE_API_KEY=
PINECONE_INDEX=ai-assistant
PINECONE_ENV=
# ---- Observability ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-assistant-dev
LANGSMITH_TRACING=true
# ---- Auth ----
AUTH_MODE=keycloak   # or dev
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ai-assistant
KEYCLOAK_CLIENT_ID=ai-assistant
KEYCLOAK_CLIENT_SECRET=
# ---- State ----
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql+asyncpg://app:app@postgres:5432/app
# ---- Rate limiting (token bucket, per minute) ----
RATE_LIMIT_VIEWER=20
RATE_LIMIT_ANALYST=60
RATE_LIMIT_ADMIN=120
# ---- Agent / RLM guards ----
MAX_DEPTH=2
MAX_RETRIES=2
NODE_BUDGET=40
# ---- Service URLs (internal) ----
GATEWAY_URL=http://gateway:8000
AGENT_URL=http://agent:8100
RETRIEVAL_URL=http://retrieval:8200
MCP_URL=http://mcp:8300
INGEST_URL=http://ingest:8400
