# ---- LLM ----
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
# ---- Embeddings ----
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
# ---- Vector DB ----
PINECONE_API_KEY=
PINECONE_INDEX=ai-assistant
PINECONE_ENV=
# ---- Observability ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-assistant-dev
LANGSMITH_TRACING=true
# ---- Auth ----
AUTH_MODE=keycloak   # or dev
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ai-assistant
KEYCLOAK_CLIENT_ID=ai-assistant
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_VERIFY_AUD=false
# KEYCLOAK_ROLE_MAP=kc-reader:Viewer,kc-analyst:Analyst,kc-admin:Administrator
PINECONE_NAMESPACE=abc-bank
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# ---- State ----
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql+asyncpg://app:app@postgres:5432/app
# ---- Rate limiting (token bucket, per minute) ----
RATE_LIMIT_VIEWER=20
RATE_LIMIT_ANALYST=60
RATE_LIMIT_ADMIN=120
# ---- Agent / RLM guards ----
MAX_DEPTH=2
MAX_RETRIES=2
NODE_BUDGET=40
# ---- Service URLs (internal) ----
GATEWAY_URL=http://gateway:8000
AGENT_URL=http://agent:8100
RETRIEVAL_URL=http://retrieval:8200
MCP_URL=http://mcp:8300
INGEST_URL=http://ingest:8400
# ---- Service URLs (ai-* topology) ----
CONVERSATION_URL=http://ai-conversation-service:8600
MODEL_GATEWAY_URL=http://ai-model-gateway:8700
KNOWLEDGE_RETRIEVAL_URL=http://ai-knowledge-retrieval:8200
KNOWLEDGE_INGEST_URL=http://ai-knowledge-ingest:8400
TOOL_SERVICE_URL=http://ai-tool-service:8300
ADMIN_SERVICE_URL=http://ai-admin-service:8800
# ---- Token budget (per-user LLM token quota; distinct from rate limit) ----
TOKEN_BUDGET_PERIOD=monthly          # daily | monthly
TOKEN_BUDGET_VIEWER=200000
TOKEN_BUDGET_ANALYST=1000000
TOKEN_BUDGET_ADMIN=5000000
# ---- Memory / cost control ----
SUMMARIZE_EVERY_N_TURNS=10
VERBATIM_TURNS=6
SEMANTIC_CACHE_THRESHOLD=0.95

# ---- Real LLM providers (pick one; offline default is the mock) ----
# LLM_PROVIDER=gemini | anthropic | openai | mock
GEMINI_API_KEY=
GEMINI_MODEL_STRONG=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.8-flash
ANTHROPIC_MODEL_STRONG=claude-sonnet-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
OPENAI_MODEL_STRONG=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
LLM_FALLBACK=            # optional: provider to use if the primary errors (e.g. openai)
GEMINI_THINKING_BUDGET=0

# ---- Keycloak clients & SSO broker (two login models) ----
KEYCLOAK_WEB_CLIENT_ID=ai-assistant-web
KEYCLOAK_ADMIN_CLIENT_ID=ai-assistant-admin
KEYCLOAK_SSO_IDP=corporate-sso
PUBLIC_BASE_URL=http://localhost:8501
# Brokered corporate IdP (fill to enable public SSO):
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_AUTH_URL=
# SSO_TOKEN_URL=
# ---- Runtime LLM config + shared offline index (server-side only; never committed) ----
LLM_CONFIG_PATH=/runtime/llm_config.json
INDEX_PATH=/kb/index.json

# ---- Service-to-service HTTP (set to run as true microservices; compose sets these) ----
ORCHESTRATOR_URL=
KNOWLEDGE_RETRIEVAL_URL=
TOOL_SERVICE_URL=
MODEL_GATEWAY_URL=
CONVERSATION_URL=
SERVICE_HTTP_TIMEOUT=60
# ---- Pinecone local emulator (docker-compose.pinecone.yml) ----
# PINECONE_HOST=http://pinecone-local:5080
# ---- Embeddings ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- Conversation memory workflow ----
# Sessions are isolated: a new session starts fresh and NO prior history is fed to the agent.
# The UI shows the user's last N sessions read-only.
HISTORY_SESSIONS=3
# memory-as-RAG: only the most relevant prior turns in the CURRENT session are sent to the LLM
MEMORY_RELEVANT_K=3
MEMORY_RELEVANT_THRESHOLD=0.35
# Real semantic embeddings for document RAG (by meaning). Blank = offline hashing embedder.
# Set to 'gemini' (uses GEMINI_API_KEY; EMBEDDING_MODEL default text-embedding-004) or 'openai'
# for true meaning-based dense retrieval; falls back to hashing if unavailable. Re-ingest after.
# EMBEDDING_PROVIDER=gemini
