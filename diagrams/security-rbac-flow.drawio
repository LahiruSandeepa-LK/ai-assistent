<mxfile host="app.diagrams.net" modified="2026-11-08T00:00:00.000Z" agent="ai-assistant-design" version="24.0.0">
  <diagram id="security-rbac" name="Security / RBAC / Rate-limit Flow">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Security — AuthN / RBAC / Rate-limit / Guardrails flow" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>

        <mxCell id="user" value="User + JWT (Keycloak)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="160" height="50" as="geometry"/></mxCell>

        <mxCell id="jwt" value="1. Validate JWT&#10;(JWKS, exp, aud) → roles" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F1C40F;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="deny1" value="401 Unauthorized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="150" height="40" as="geometry"/></mxCell>

        <mxCell id="rbac1" value="2. Edge RBAC&#10;endpoint allowed for role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F1C40F;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="deny2" value="403 Forbidden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="530" y="200" width="150" height="40" as="geometry"/></mxCell>

        <mxCell id="rl" value="3. Token-bucket rate limit&#10;(Redis, per-user/role)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F1C40F;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="80" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="deny3" value="429 + Retry-After&#10;(graceful UI msg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="160" height="40" as="geometry"/></mxCell>

        <mxCell id="val" value="4. Input validation&#10;(Pydantic schema, length caps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="200" height="50" as="geometry"/></mxCell>

        <mxCell id="inj" value="5. Input guardrail&#10;prompt-injection screen (override/exfil/jailbreak)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="260" height="60" as="geometry"/></mxCell>

        <mxCell id="graph" value="6. LangGraph (signed user ctx — roles NOT from prompt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D5091;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="400" width="300" height="50" as="geometry"/></mxCell>

        <mxCell id="pep" value="7. Policy Enforcement Point&#10;before EVERY tool/retrieval:&#10;(roles, action, resource)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F1C40F;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="490" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="deny4" value="unauthorized (traced)&#10;→ tool blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="180" height="50" as="geometry"/></mxCell>

        <mxCell id="tool" value="8. Tool executes&#10;(async, timeout, circuit-breaker, sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#117A65;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="250" height="60" as="geometry"/></mxCell>

        <mxCell id="retrfilter" value="9. Retrieval access_level filter&#10;(never fetch above clearance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#117A65;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="860" y="500" width="250" height="60" as="geometry"/></mxCell>

        <mxCell id="outguard" value="10. Output guardrails&#10;groundedness · citation integrity · brand-safety · secret redaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="630" width="320" height="60" as="geometry"/></mxCell>

        <mxCell id="audit" value="11. Audit log (Postgres) + LangSmith metadata&#10;every authz decision, tool exec, refusal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5D6D7E;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="730" width="320" height="50" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="s1" style="endArrow=block;html=1;" edge="1" parent="1" source="user" target="jwt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s1d" value="invalid" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="jwt" target="deny1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2" value="valid" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="jwt" target="rbac1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2d" value="no" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="rbac1" target="deny2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s3" value="yes" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="rbac1" target="rl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s3d" value="exhausted" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="rl" target="deny3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4" value="ok" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="rl" target="val"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s5" style="endArrow=block;html=1;" edge="1" parent="1" source="val" target="inj"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6" style="endArrow=block;html=1;" edge="1" parent="1" source="inj" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s7" style="endArrow=block;html=1;" edge="1" parent="1" source="graph" target="pep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s7d" value="deny" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="pep" target="deny4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s8" value="allow" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="pep" target="tool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s9" style="endArrow=block;html=1;" edge="1" parent="1" source="tool" target="retrfilter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s10" style="endArrow=block;html=1;" edge="1" parent="1" source="tool" target="outguard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s11" style="endArrow=block;html=1;" edge="1" parent="1" source="outguard" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
