<mxfile host="app.diagrams.net" modified="2026-11-08T00:00:00.000Z" agent="ai-assistant-design" version="24.0.0">
  <diagram id="admin-doc-flow" name="Admin Document-Management Flow">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Admin Console → Document Management → Ingestion (Interface 2, Administrator-only)" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell>

        <mxCell id="admin" value="Administrator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="130" height="60" as="geometry"/></mxCell>
        <mxCell id="uiadm" value="ui-admin&#10;[Streamlit]&#10;upload / update / delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="105" width="170" height="70" as="geometry"/></mxCell>

        <mxCell id="gw" value="gateway /admin/documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="440" y="105" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="authz" value="role == Administrator?&#10;(edge + PEP)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F1C40F;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="680" y="95" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="deny" value="403 Forbidden&#10;(audited)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="130" height="50" as="geometry"/></mxCell>

        <mxCell id="ingest" value="ingestion service  /ingest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="920" y="105" width="190" height="70" as="geometry"/></mxCell>

        <!-- pipeline -->
        <mxCell id="pipe" value="ingestion pipeline (async)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6A1B9A;verticalAlign=top;fontColor=#6A1B9A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="360" y="300" width="760" height="120" as="geometry"/></mxCell>
        <mxCell id="p1" value="1. validate&#10;(type/size, scan,&#10;sanitize instructions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;fontSize=9;" vertex="1" parent="1"><mxGeometry x="375" y="335" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="p2" value="2. section-aware&#10;chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5499C7;fontColor=#ffffff;fontSize=9;" vertex="1" parent="1"><mxGeometry x="545" y="335" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="p3" value="3. embed (dense) +&#10;sparse vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5499C7;fontColor=#ffffff;fontSize=9;" vertex="1" parent="1"><mxGeometry x="705" y="335" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="p4" value="4. upsert to Pinecone&#10;(namespace + metadata)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5499C7;fontColor=#ffffff;fontSize=9;" vertex="1" parent="1"><mxGeometry x="875" y="335" width="170" height="70" as="geometry"/></mxCell>

        <mxCell id="pc" value="Pinecone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="pg" value="Postgres&#10;document registry (status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="470" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="status" value="5. status → ui-admin&#10;(queued→indexed) + audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5D6D7E;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="220" y="465" width="250" height="60" as="geometry"/></mxCell>

        <mxCell id="pub" value="Public Assistant can now retrieve the new/updated content (normal retrieval path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="560" width="600" height="40" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="admin" target="uiadm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="upload (multipart)" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="uiadm" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;" edge="1" parent="1" source="gw" target="authz"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="no" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="authz" target="deny"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="yes → DocumentOp" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="authz" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;" edge="1" parent="1" source="ingest" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;" edge="1" parent="1" source="p4" target="pc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="write status" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="p4" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="endArrow=block;html=1;" edge="1" parent="1" source="pg" target="status"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="endArrow=open;html=1;dashed=1;" edge="1" parent="1" source="status" target="uiadm"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
