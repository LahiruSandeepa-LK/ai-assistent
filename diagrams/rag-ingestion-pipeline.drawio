<mxfile host="app.diagrams.net" modified="2026-11-09T00:00:00.000Z" agent="ai-assistant-design" version="24.0.0">
  <diagram id="rag-ingest" name="RAG Ingestion Pipeline">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RAG Write Path — Ingestion Pipeline (ai-knowledge-service / ingestion)" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell>

        <mxCell id="src" value="source documents&#10;(admin upload  OR  batch CLI)&#10;policies · incidents · runbooks · specs · meeting notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="90" as="geometry"/></mxCell>

        <mxCell id="s1" value="1. load / extract&#10;(pdf, md, html, docx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5499C7;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="95" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="s2" value="2. clean / normalize&#10;+ sanitize injected instructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="530" y="95" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s3" value="3. chunk (section-aware)&#10;strategy per doc type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5499C7;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s4" value="4. enrich metadata&#10;dept · type · access_level&#10;· date · section · version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5499C7;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="950" y="95" width="190" height="80" as="geometry"/></mxCell>

        <mxCell id="s5" value="5. embed (dense) + build sparse vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5499C7;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="230" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="emb" value="Embedding Provider" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="950" y="330" width="190" height="45" as="geometry"/></mxCell>

        <mxCell id="s6" value="6. upsert (idempotent)&#10;chunk_id = sha256(doc_id+section+ordinal)&#10;into namespace by document_type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5499C7;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="pc" value="Pinecone&#10;(sparse-dense index, namespaces)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="s7" value="7. write/version document registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="pg" value="Postgres (document registry: status, version, chunk count)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="s8" value="8. status → ai-admin-service console (queued → indexed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="400" height="40" as="geometry"/></mxCell>

        <mxCell id="note" value="READ path (ai-knowledge-service / retrieval) queries the SAME Pinecone index + registry — see rag-hybrid-retrieval-sequence.drawio. Re-indexing never blocks live queries (separate deployable)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B9770E;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520" y="540" width="620" height="60" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="e0" style="endArrow=block;html=1;" edge="1" parent="1" source="src" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
